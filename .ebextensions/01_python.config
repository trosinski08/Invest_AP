option_settings:
  aws:elasticbeanstalk:application:environment:
    PYTHONPATH: /var/app/current
    # Do NOT put secret values here.
    # Set via EB Console > Configuration > Software > Environment properties
    # or via AWS Secrets Manager / Parameter Store.
    #
    # Required vars (all environments):
    #   OPENAI_API_KEY
    #   IS_PAPER_TRADING       — "true" for paper, "false" for real money
    #
    # Required vars (real-money mode only):
    #   BINANCE_API_KEY
    #   BINANCE_SECRET_KEY
    #
    # Storage (recommended for EB):
    #   DATA_DIR               — path writable by the EB instance (e.g. /tmp/invest_ap)
    #                            or mount an EFS volume here for persistence
    #
    # Optional (trading parameters):
    #   TRADING_PAIR, TIMEFRAME, MAX_ORDER_VALUE_USD, MAX_DAILY_LOSS_USD,
    #   MAX_TRADES_PER_24H, COOLDOWN_MINUTES, SENTIMENT_THRESHOLD
